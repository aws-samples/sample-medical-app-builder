{
  "name": "med_app",
  "private": true,
  "version": "0.1.0",
  "description": "Manifest-driven clinical app runtime: Cognito sign-in, deterministic manifest renderer, Medplum React component wrappers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:seed": "node --experimental-strip-types scripts/export-seed.ts",
    "export:kinds": "node scripts/appspec.mjs kinds --out ../infra/lambdas/dispatcher/data/record-kinds.json",
    "appspec": "node scripts/appspec.mjs",
    "showcase": "node scripts/build-showcase.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@mantine/spotlight": "^8.3.18",
    "@medplum/core": "5.1.37",
    "@medplum/definitions": "5.1.37",
    "@medplum/fhirtypes": "5.1.37",
    "@medplum/mock": "5.1.37",
    "@medplum/react": "5.1.37",
    "@medplum/react-hooks": "5.1.37",
    "@tabler/icons-react": "^3.46.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "signature_pad": "^5.0.10",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
