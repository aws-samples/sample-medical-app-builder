# ─────────────────────────────────────────────────────────────────────────────
# med_app runtime configuration
# Copy to `.env` (git-ignored) and fill in. Only VITE_* variables reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Hospital deployment this frontend belongs to (matches metadata.hospital_id in manifests),
# and the name shown in the top bar and on the sign-in screen.
VITE_HOSPITAL_ID=hsp-musterstadt
VITE_HOSPITAL_NAME=Klinikum Musterstadt

# ── Authentication ───────────────────────────────────────────────────────────
# cognito  → real sign-in against the hospital's Cognito user pool.
# mock     → DEV ONLY. Same sign-in screen, any credentials accepted, role switcher enabled.
VITE_AUTH_MODE=cognito

VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App registry ─────────────────────────────────────────────────────────────
# local   → the manifests/*.yaml bundled with this build (development, catalog work).
# remote  → the registry API over the hospital's DynamoDB table (needs cognito auth + API URL).
VITE_REGISTRY_MODE=local

# ── Data plane ───────────────────────────────────────────────────────────────
# mock        → in-browser FHIR server (@medplum/mock) seeded with synthetic Musterstadt patients.
# dispatcher  → primitive dispatcher Lambda (needs cognito auth + API URL). Enforces manifest, role
#               and scope server-side; serves the same synthetic patients until the hospital FHIR
#               server is connected (infra: -c data_source=fhir).
VITE_DATA_MODE=mock

# The deployment's HTTP API (ApiStack output ViteApiBaseUrl): /registry/*, /primitives/*, /drafts/*, /users/*, /audit.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-central-1.amazonaws.com

# ── Imaging ──────────────────────────────────────────────────────────────────
# Base URL of an OHIF viewer deployment. Leave empty to render the study placeholder.
VITE_OHIF_VIEWER_URL=
# Which of the viewer's data sources studies open from (`/viewer/<name>`). Leave empty: the viewer's default on
# real data; `reference` (the synthetic record's PACS) in mock data mode and in every preview.
VITE_OHIF_DATA_SOURCE=

# The hospital's look over the defaults of src/branding.ts — what a deployment gets from infra/hospitals/<id>.json via
# config.json. Any subset of the ten colours (#RRGGBB) and/or a logo served under /branding/ (put the files in
# public/branding/ for the dev server). Quote the value in this file — unquoted, dotenv cuts it at the first `#`.
# VITE_BRANDING='{"palette":{"accent":"#1F5FA8"},"logo":{"src":"/branding/logo.svg","alt":"Klinikum","height":28}}'
VITE_BRANDING=

# ── Drafting assistant in mock mode ─────────────────────────────────────────
# The assistant runs on Amazon Bedrock behind the deployed API, so with the local registry nothing answers (`offline`).
# `replay` plays a recorded session back turn by turn — the model's real replies and tool calls — so the drafting page can be
# seen and developed without a deployment (src/authoring/replay/bp-trend.json). Type anything; the script answers in order.
VITE_AGENT_MODE=offline
