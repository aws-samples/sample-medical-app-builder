  "media_rules": {"kinds": ["urn:medapp:photo|wound", "urn:medapp:photo|pressure_ulcer"], "body_site": true, "max_bytes": 1500000, "max_backdate_days": 30},
  "media_rules_small": {"kinds": ["urn:medapp:photo|wound"], "body_site": false, "max_bytes": 20, "max_backdate_days": 30},
  "media_cases": [
    {"name": "a wound photo of the patient, jpeg, taken this morning, passes", "rules": "media_rules", "payload": {"resourceType": "Media", "type": {"coding": [{"code": "photo"}]}, "reasonCode": [{"coding": [{"system": "urn:medapp:photo", "code": "wound"}]}], "subject": {"reference": "Patient/pat-kms-0001"}, "content": {"contentType": "image/jpeg", "data": "XHg4OVBOR1xyXG5ceDFhXG4="}, "bodySite": {"text": "Left heel"}, "createdDateTime": "2026-09-11T08:30:00Z", "note": [{"text": "Day 3."}]}, "expected": []},
    {"name": "a video, a kind the form does not offer, another patient", "rules": "media_rules", "payload": {"resourceType": "Media", "type": {"coding": [{"code": "video"}]}, "reasonCode": [{"coding": [{"system": "urn:medapp:photo", "code": "rash"}]}], "subject": {"reference": "Patient/x"}, "content": {"contentType": "image/jpeg", "data": "XHg4OVBOR1xyXG5ceDFhXG4="}}, "expected": ["a photo is recorded, not 'video'", "code urn:medapp:photo|rash is not one this form may record (urn:medapp:photo|wound, urn:medapp:photo|pressure_ulcer)", "photo subject Patient/x is not the patient in context"]},
    {"name": "a gif, and no image data", "rules": "media_rules", "payload": {"resourceType": "Media", "type": {"coding": [{"code": "photo"}]}, "reasonCode": [{"coding": [{"system": "urn:medapp:photo", "code": "wound"}]}], "subject": {"reference": "Patient/pat-kms-0001"}, "content": {"contentType": "image/gif"}}, "expected": ["content type 'image/gif' is not one of image/jpeg, image/png, image/webp", "the photo has no image data"]},
