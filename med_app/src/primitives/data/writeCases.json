    {"name": "a code the form does not offer, another patient, a status that is not requested, a priority not offered", "rules": "task_rules", "payload": {"resourceType": "Task", "code": {"coding": [{"system": "urn:medapp:task", "code": "lab_order"}]}, "for": {"reference": "Patient/x"}, "status": "completed", "priority": "stat"}, "expected": ["code urn:medapp:task|lab_order is not one this form may record (urn:medapp:task|falls_screen, urn:medapp:task|discharge_letter)", "task patient Patient/x is not the patient in context", "a new task is requested, not 'completed'", "priority 'stat' is not one of routine, urgent"]},
    {"name": "due yesterday, an unreadable due date is its own problem", "rules": "task_rules", "payload": {"resourceType": "Task", "code": {"coding": [{"system": "urn:medapp:task", "code": "falls_screen", "display": "Falls risk screen"}]}, "for": {"reference": "Patient/pat-kms-0001"}, "restriction": {"period": {"end": "2026-09-10"}}}, "expected": ["due date must not be in the past"]},
    {"name": "due today is fine; a description too long is not", "rules": "task_rules", "payload": {"resourceType": "Task", "code": {"coding": [{"system": "urn:medapp:task", "code": "falls_screen", "display": "Falls risk screen"}]}, "for": {"reference": "Patient/pat-kms-0001"}, "restriction": {"period": {"end": "2026-09-11"}}, "description": ""}, "expected": ["description must be text of at most 500 characters"]},
