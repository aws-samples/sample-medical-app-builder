  "record_rules": {
    "resource": "Goal",
    "fields": [
      { "id": "goal", "label": "Goal", "type": "text", "path": "description", "as": "concept_text", "required": true, "max_length": 20 },
      { "id": "measure", "label": "Measured by", "type": "code", "path": "target[0].measure", "as": "codeable_concept", "required": true, "codes": [{ "system": "https://hsp-musterstadt.medapp.eu/CodeSystem/physio", "code": "tug", "display": "Timed up-and-go" }] },
      { "id": "target", "label": "Target value", "type": "number", "path": "target[0].detailQuantity", "as": "quantity", "unit": "s", "range": { "min": 0, "max": 600 } },
      { "id": "due", "label": "Due", "type": "date", "path": "target[0].dueDate", "as": "date", "future_days": 365 },
      { "id": "priority", "label": "Priority", "type": "choice", "path": "priority", "as": "codeable_concept", "options": [{ "code": "high-priority", "display": "High" }], "system": "http://terminology.hl7.org/CodeSystem/goal-priority" },
      { "id": "note", "label": "Remark", "type": "long_text", "path": "note[0].text", "as": "string", "max_length": 2000 }
    ],
    "stamps": [{ "path": "lifecycleStatus", "value": "active" }, { "path": "subject", "value": "$patient" }, { "path": "expressedBy", "value": "$author" }, { "path": "statusDate", "value": "$today" }]
  },
  "note_rules": {
    "resource": "DocumentReference",
    "fields": [
      { "id": "type", "label": "Kind of note", "type": "code", "path": "type", "as": "codeable_concept", "required": true, "codes": [{ "system": "http://loinc.org", "code": "11506-3", "display": "Progress note" }] },
      { "id": "text", "label": "Note", "type": "long_text", "path": "content[0].attachment", "as": "attachment_text", "required": true, "max_length": 30 }
    ],
    "stamps": [{ "path": "status", "value": "current" }, { "path": "subject", "value": "$patient" }, { "path": "date", "value": "$now" }, { "path": "author[0]", "value": "$author" }]
  },
  "consent_rules": {
    "resource": "Consent",
    "fields": [
      { "id": "scope", "label": "Kind of consent", "type": "choice", "path": "scope", "as": "codeable_concept", "required": true, "options": [{ "code": "treatment", "display": "Treatment" }, { "code": "research", "display": "Research" }], "system": "http://terminology.hl7.org/CodeSystem/consentscope" },
      { "id": "category", "label": "Document type", "type": "code", "path": "category[0]", "as": "codeable_concept", "required": true, "codes": [{ "system": "http://loinc.org", "code": "59284-0", "display": "Patient Consent" }] },
      { "id": "decision", "label": "Decision", "type": "choice", "path": "provision.type", "as": "code", "required": true, "options": [{ "code": "permit", "display": "Permitted" }, { "code": "deny", "display": "Denied" }] },
      { "id": "purpose", "label": "Purpose", "type": "code", "path": "provision.purpose[0]", "as": "coding", "required": true, "codes": [{ "system": "http://terminology.hl7.org/CodeSystem/v3-ActReason", "code": "TREAT", "display": "Treatment" }, { "system": "http://terminology.hl7.org/CodeSystem/v3-ActReason", "code": "HRESCH", "display": "Healthcare research" }] },
      { "id": "until", "label": "Valid until", "type": "date", "path": "provision.period.end", "as": "datetime", "future_days": 3650 }
    ],
    "stamps": [{ "path": "status", "value": "active" }, { "path": "patient", "value": "$patient" }, { "path": "dateTime", "value": "$now" }]
  },
  "record_cases": [
    {
      "name": "a goal within its declared shape passes",
      "rules": "record_rules",
      "payload": { "resourceType": "Goal", "identifier": [{ "system": "urn:medapp:submission", "value": "g-1" }], "description": { "text": "Walk unaided" }, "target": [{ "measure": { "coding": [{ "system": "https://hsp-musterstadt.medapp.eu/CodeSystem/physio", "code": "tug", "display": "Timed up-and-go" }], "text": "Timed up-and-go" }, "detailQuantity": { "value": 11.5, "unit": "s" }, "dueDate": "2026-12-01" }], "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/goal-priority", "code": "high-priority", "display": "High" }], "text": "High" }, "note": [{ "text": "Agreed with the patient." }] },
      "expected": []
    },
    {
      "name": "the wrong resource type",
      "rules": "record_rules",
      "payload": { "resourceType": "Condition" },
      "expected": ["payload must be a Goal"]
    },
    {
      "name": "required fields missing, named as the form labels them",
      "rules": "record_rules",
      "payload": { "resourceType": "Goal", "target": [{ "detailQuantity": { "value": 11, "unit": "s" } }] },
      "expected": ["\"Goal\" is required", "\"Measured by\" is required"]
    },
    {
      "name": "too long, out of range, in another unit, too far ahead, an option not offered",
      "rules": "record_rules",
      "payload": { "resourceType": "Goal", "description": { "text": "A goal far longer than twenty" }, "target": [{ "measure": { "coding": [{ "system": "https://hsp-musterstadt.medapp.eu/CodeSystem/physio", "code": "tug" }] }, "detailQuantity": { "value": 900, "unit": "min" }, "dueDate": "2028-01-01" }], "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/goal-priority", "code": "urgent" }] } },
      "expected": ["\"Goal\": 29 characters is more than the 20 allowed", "\"Target value\": the value must be in s, not min", "\"Target value\": 900 s is outside the accepted range 0–600", "\"Due\" must not be more than 365 days ahead", "\"Priority\": http://terminology.hl7.org/CodeSystem/goal-priority|urgent is not one of the offered options (http://terminology.hl7.org/CodeSystem/goal-priority|high-priority)"]
    },
    {
      "name": "elements the shape did not declare are refused by name; stamped elements may be sent (they are overwritten)",
      "rules": "record_rules",
      "payload": { "resourceType": "Goal", "lifecycleStatus": "completed", "subject": { "reference": "Patient/pat-kms-0001" }, "description": { "text": "Walk unaided" }, "target": [{ "measure": { "coding": [{ "system": "https://hsp-musterstadt.medapp.eu/CodeSystem/physio", "code": "tug" }] }, "detailString": "fast" }], "outcomeCode": [{ "text": "achieved" }] },
      "expected": ["element target[0].detailString is not part of this form", "element outcomeCode[0].text is not part of this form"]
    },
    {
      "name": "another patient's goal",
      "rules": "record_rules",
      "payload": { "resourceType": "Goal", "subject": { "reference": "Patient/pat-kms-0002" }, "description": { "text": "Walk unaided" }, "target": [{ "measure": { "coding": [{ "system": "https://hsp-musterstadt.medapp.eu/CodeSystem/physio", "code": "tug" }] } }] },
      "expected": ["subject Patient/pat-kms-0002 is not the patient in context"]
    },
    {
      "name": "a note as a text/plain attachment passes; one too long, or not text/plain, or not base64, does not",
      "rules": "note_rules",
      "payload": { "resourceType": "DocumentReference", "type": { "coding": [{ "system": "http://loinc.org", "code": "11506-3" }] }, "content": [{ "attachment": { "contentType": "text/plain", "data": "V2VlayAzOiBUVUcgMTQgcy4=" } }] },
      "expected": []
    },
    {
      "name": "a note that is too long and not text/plain",
      "rules": "note_rules",
      "payload": { "resourceType": "DocumentReference", "type": { "coding": [{ "system": "http://loinc.org", "code": "11506-3" }] }, "content": [{ "attachment": { "contentType": "text/html", "data": "QSBub3RlIHRoYXQgcnVucyB3ZWxsIG92ZXIgdGhpcnR5IGNoYXJhY3RlcnMu" } }] },
      "expected": ["\"Note\": the attachment must be text/plain", "\"Note\": 45 characters is more than the 30 allowed"]
    },
    {
      "name": "a note whose data is not base64 has no text",
      "rules": "note_rules",
      "payload": { "resourceType": "DocumentReference", "type": { "coding": [{ "system": "http://loinc.org", "code": "11506-3" }] }, "content": [{ "attachment": { "contentType": "text/plain", "data": "not base64!" } }] },
      "expected": ["\"Note\": text is required"]
    },
    {
      "name": "a consent decision within its shape passes: the kind, the document type, permit or deny, the purpose, a validity",
      "rules": "consent_rules",
      "payload": { "resourceType": "Consent", "identifier": [{ "system": "urn:medapp:submission", "value": "c1" }], "scope": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/consentscope", "code": "research", "display": "Research" }], "text": "Research" }, "category": [{ "coding": [{ "system": "http://loinc.org", "code": "59284-0", "display": "Patient Consent" }], "text": "Patient Consent" }], "provision": { "type": "deny", "purpose": [{ "system": "http://terminology.hl7.org/CodeSystem/v3-ActReason", "code": "HRESCH", "display": "Healthcare research" }], "period": { "end": "2030-01-01" } } },
      "expected": []
    },
    {
      "name": "a consent without its decision and purpose, with a kind the shape does not offer, and a stray performer",
      "rules": "consent_rules",
      "payload": { "resourceType": "Consent", "scope": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/consentscope", "code": "adr" }] }, "category": [{ "coding": [{ "system": "http://loinc.org", "code": "59284-0" }] }], "performer": [{ "reference": "Patient/pat-kms-0001" }], "provision": { "period": { "end": "2040-01-01" } } },
      "expected": ["\"Kind of consent\": http://terminology.hl7.org/CodeSystem/consentscope|adr is not one of the offered options (http://terminology.hl7.org/CodeSystem/consentscope|treatment, http://terminology.hl7.org/CodeSystem/consentscope|research)", "\"Decision\" is required", "\"Purpose\" is required", "\"Valid until\" must not be more than 3650 days ahead", "element performer[0].reference is not part of this form"]
    }
  ]
}
